# ===== CONTROLLER (set these as Render environment variables) =====
DATABASE_URL=postgres://user:pass@host/db          # external free Postgres (Neon/Supabase) recommended
API_TOKEN=change-me-long-random                     # "run" role: do/run/list/logs/stop
ADMIN_TOKEN=change-me-different-long-random         # "admin" role: schedules, recipes, stop-all, destructive actions
HOST_URL=https://your-host-tunnel.example.com       # where the host API is reachable from Render (see docs/SETUP.md)
HOST_TOKEN=frogy_xxx                                # printed ONCE by `frogy-host init`
MAX_CONCURRENT=5
DAILY_TOKEN_BUDGET=500000                           # hard stop for AI spend per UTC day
DAILY_USD_BUDGET=0                                  # optional dollar cap (needs "prices" in frogy.config.json); 0 = off
DIGEST_HOUR_UTC=                                    # e.g. 2 -> daily digest at 02:00 UTC; empty = off
TELEGRAM_CONTROL=false                              # true = obey /status /stop /answer from your private chat
SCHEDULER_TICK_SECONDS=30
APPROVAL_TIMEOUT_HOURS=12
# Agents
TAINT_POLICY=approve                                # approve (default) | flag | off — tainted agents need your OK for real side effects
FROGY_MCP_CONFIG=./frogy.mcp.json                   # optional MCP tool servers (see frogy.mcp.example.json)
AGENT_MAX_STEPS=15
AGENT_TOKEN_BUDGET=100000
SUBAGENT_MAX_STEPS=12
SUBAGENT_TOKEN_BUDGET=40000
# Alerts (optional but strongly recommended for overnight use)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
# LLM keys (controller only; never sent to the host or any sandbox). Only needed for `frogy run "free text"`.
FROGY_CONFIG=./frogy.config.json
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# ===== HOST (your VPS / home machine; NOT on Render) =====
HOST_DATA_DIR=/var/lib/frogy/host-data
HOST_BIND=127.0.0.1          # or your tunnel/Tailscale IP
HOST_PORT=8787
HOST_ADMIN_PORT=8788         # always bound to 127.0.0.1
GOOGLE_OAUTH_PORT=8789
# FROGY_HOST_PASSPHRASE=     # OPTIONAL auto-unlock. Weaker: the passphrase then exists on the machine. Prefer typing `frogy-host unlock`.
