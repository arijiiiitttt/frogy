{
  "name": "frogy",
  "version": "0.1.0",
  "description": "frogy, sandbox agent",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "frogy": "dist/cli/main.js",
    "sbx": "dist/cli/main.js",
    "frogy-host": "dist/host/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/controller/main.js",
    "start:host": "node dist/host/main.js serve",
    "dev:controller": "tsx src/controller/main.ts",
    "dev:host": "tsx src/host/main.ts serve",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
